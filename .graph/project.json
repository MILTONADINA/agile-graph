  "name": "Graph Engineering",
  "policy": {
    "version": "1.0.0",
    "inference": "allowlisted",
    "providers": ["qwen", "laya"],
    "network": "allowlisted",
    "allowedHosts": [],
    "exportPaths": [
      "README.md",
      "CONTRIBUTING.md",
      "docs/**",
      "packages/*/src/**",
      "packages/*/tests/**"
    ],
    "excludedPaths": [
      ".env",
      ".env.*",
      "*.pem",
      "*.key",
      "**/credentials*",
      "**/secrets*"
    ],
    "publication": "none",
    "maxWorkers": 2,
    "maxAttempts": 3,
    "maxContextTokens": 16000,
    "maxOutputTokens": 4000,
    "maxTurns": 12,
    "timeoutSeconds": 600,
    "maxCostUsd": 0,
    "decisionMode": "shadow",
    "promotedCategories": []
  },
  "verification": [
    {
