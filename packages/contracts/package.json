{
  "name": "@agile-graph/contracts",
  "version": "0.1.1",
  "description": "Versioned schemas shared by the Agile Graph engine: project policy, context, execution plans, runs and decisions.",
  "keywords": [
    "agile-graph",
    "schemas",
    "contracts",
    "ai-agents"
  ],
  "homepage": "https://github.com/MILTONADINA/agile-graph/tree/main/packages/contracts#readme",
  "bugs": {
    "url": "https://github.com/MILTONADINA/agile-graph/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MILTONADINA/agile-graph.git",
    "directory": "packages/contracts"
  },
  "license": "MIT",
  "author": "Milton Adina",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "engines": {
    "node": "^22.18.0 || >=24 <27"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepack": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run build"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
