{
  "name": "@agile-graph/engine",
  "version": "0.3.0",
  "description": "An AI agile team for your repository: test-first AI workers in isolated Git worktrees, behind the checks, code review and security scans you approve.",
  "keywords": [
    "agile-graph",
    "ai-agents",
    "agile",
    "mcp",
    "code-review",
    "security-scanning",
    "developer-tools",
    "cli"
  ],
  "homepage": "https://github.com/MILTONADINA/agile-graph/tree/main/packages/engine#readme",
  "bugs": {
    "url": "https://github.com/MILTONADINA/agile-graph/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MILTONADINA/agile-graph.git",
    "directory": "packages/engine"
  },
  "license": "MIT",
  "author": "Milton Adina",
  "type": "module",
  "bin": {
    "agile-graph": "dist/cli.js",
    "graph-engine": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/build-source.json",
    "dashboard",
    "scanner",
    "security/dart-analyzer-seccomp.json",
    "vendor/cloudflare-security-audit",
    "NOTICE"
  ],
  "engines": {
    "node": "^22.18.0 || >=24 <27"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/write-build-source.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js",
    "prepack": "node scripts/prepack.mjs"
  },
  "dependencies": {
    "@agile-graph/contracts": "0.3.0",
    "@fastify/static": "10.1.6",
    "@modelcontextprotocol/sdk": "1.32.1",
    "better-sqlite3": "13.0.3",
    "commander": "^14.0.0",
    "env-paths": "^3.0.0",
    "fastify": "5.12.7",
    "ignore": "^7.0.12",
    "picomatch": "^4.0.3",
    "sqlite-vec": "0.1.9",
    "tree-sitter-wasms": "0.1.13",
    "typescript": "5.9.3",
    "web-tree-sitter": "0.25.10",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@cursor/sdk": "^1.0.32",
    "@huggingface/transformers": "^4.3.0"
  },
  "peerDependenciesMeta": {
    "@cursor/sdk": {
      "optional": true
    },
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cursor/sdk": "1.0.32",
    "@huggingface/transformers": "4.3.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/picomatch": "^4.0.2"
  }
}
